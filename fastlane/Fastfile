# あそびば リリースパイプライン
# 前提となる環境変数（~/.zshrc に設定済み。リポジトリにはコミットしない）:
#   ASC_KEY_ID     : App Store Connect API キーの Key ID
#   ASC_ISSUER_ID  : 同 Issuer ID
#   ASC_KEY_PATH   : .p8 ファイルの絶対パス（~/.appstoreconnect/ 配下）
#
# 実績のある構成（2026-08-11 v1.1.0 build 5 で実証）:
# - Team ID: 6MGM38HWDH（証明書名の括弧内 WLUV6S77T5 は証明書IDなので混同しないこと）
# - API キーは Developer ロールのため証明書発行・ストア操作は不可。アップロードのみ使用
# - archive/export は Xcode ログイン済みアカウントのセッションで署名
#   （Distribution 証明書は初回 export 時に自動発行済み・キーチェーンに存在）

default_platform(:ios)

TEAM_ID = "6MGM38HWDH"

platform :ios do
  desc "GameKit の全テストを実行"
  lane :test do
    sh("swift", "test", "--package-path", "../Packages/GameKit")
  end

  desc "TestFlight へアップロード（ビルド番号は project.yml の CURRENT_PROJECT_VERSION を使用）"
  lane :beta do
    # MARKETING_VERSION の更新は配信直前の手作業なので、ここが唯一「ブランチ名と一致して
    # いなければならない瞬間」になる。ビルドを始める前に落とす（#161）
    sh("bash", "../Scripts/check-marketing-version.sh")

    sh("xcodegen", "generate", "--project", "..")

    build_app(
      project: "../GameCollection.xcodeproj",
      scheme: "GameCollection",
      export_method: "app-store-connect",
      export_options: {
        teamID: TEAM_ID,
        signingStyle: "automatic",
        uploadSymbols: true,
      },
      xcargs: "-allowProvisioningUpdates CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{TEAM_ID}",
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"],
    )
  end
end

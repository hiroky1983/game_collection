# あそびば リリースパイプライン
# 認証（#1041）: Admin 権限の ASC API キー ~/.appstoreconnect/asc-key.json
#   {"key_id": ..., "issuer_id": ..., "key": "<.p8 の中身>"}
# を読む。ファイルが無いときだけ従来の環境変数（ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH）に戻る
# （~/.zshrc の旧キーは Developer ロールで証明書を作れないので、通常は JSON 側が使われる）。
#
# 署名: archive / export とも `-authenticationKey*` で API キー認証し、Xcode のログイン状態と
# キーチェーンの Distribution 証明書に頼らない。証明書・プロファイルが無い／切れていれば
# `-allowProvisioningUpdates` が API キーで発行し直す（2026-09-16 の「No Accounts」事故の再発防止）。
# - Team ID: 6MGM38HWDH（証明書名の括弧内 WLUV6S77T5 は証明書IDなので混同しないこと）
# - Distribution 証明書は枚数に上限がある。上限に当たったら自動で失効させず、`signing_check` が
#   一覧を出して止まる（失効は他の Mac・CI の署名を壊しうるので会長が判断する）

require "json"
require "tmpdir"

default_platform(:ios)

TEAM_ID = "6MGM38HWDH"
ASC_KEY_JSON = File.expand_path("~/.appstoreconnect/asc-key.json")
# 出荷系のログはここへ全量残す（#1041。tail で切ると EXPORT FAILED の理由が消える）
SHIP_LOG_DIR = File.expand_path("~/Library/Logs/asobiba-ship")
# Apple Distribution 証明書の上限（超えると新規発行が失敗する）
DISTRIBUTION_CERT_LIMIT = 3

# [key_id, issuer_id, key の中身] を返す。中身はログに出さない。
def asc_key_material
  if File.exist?(ASC_KEY_JSON)
    d = JSON.parse(File.read(ASC_KEY_JSON))
    [d.fetch("key_id"), d.fetch("issuer_id"), d.fetch("key")]
  else
    [ENV.fetch("ASC_KEY_ID"), ENV.fetch("ASC_ISSUER_ID"), File.read(ENV.fetch("ASC_KEY_PATH"))]
  end
end

def asc_api_key
  key_id, issuer_id, key = asc_key_material
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_content: key, in_house: false)
end

platform :ios do
  desc "GameKit の全テストを実行"
  lane :test do
    sh("swift", "test", "--package-path", "../Packages/GameKit")
  end

  desc "TestFlight へアップロード（ビルド番号は project.yml の CURRENT_PROJECT_VERSION を使用）"
  lane :beta do
    # MARKETING_VERSION の更新は配信直前の手作業なので、ここが唯一「ブランチ名と一致して
    # いなければならない瞬間」になる。ビルドを始める前に落とす（#161）
    sh("bash", "../Scripts/check-marketing-version.sh")

    # 署名の前提（Distribution 証明書か API キー）。無ければ 20 分アーカイブする前に落とす（#1041）
    sh("bash", "../Scripts/check-signing-prereqs.sh")

    # 入稿パックの「収録N本」が実装のゲーム数と一致しているか（#281）。
    # ゲーム追加 PR の直後は必ず不一致になる正常な途中状態があるので CI では見ず、
    # 出荷する中身が確定するこの瞬間だけで落とす（理由はスクリプト冒頭のコメント）
    sh("bash", "../Scripts/check-aso-game-count.sh")

    # xcodegen の `--project` は**出力先**の指定で、spec の場所は `--spec`。
    # fastlane の sh は fastlane/ を cwd に実行するため、spec を明示しないと
    # fastlane/project.yml を探して落ちる（2026-08-30 に顕在化）。
    sh("xcodegen", "generate", "--spec", "../project.yml", "--project", "..")
    # 依存の版を Config/Package.resolved で固定する（#1579）。xcodegen が作り直すたびに
    # Package.resolved が消え、ビルドごとに SDK の版が変わっていた
    sh("bash", "../Scripts/apply-package-resolved.sh")

    FileUtils.mkdir_p(SHIP_LOG_DIR)
    key_id, issuer_id, key = asc_key_material
    # xcodebuild の -authenticationKeyPath は .p8 のファイルを要るので、実行中だけ一時ファイルに書く
    auth_dir = Dir.mktmpdir("asobiba-asc")
    begin
    key_file = File.join(auth_dir, "AuthKey_#{key_id}.p8")
    File.write(key_file, key)
    File.chmod(0o600, key_file)
    auth_args = "-authenticationKeyPath #{key_file} -authenticationKeyID #{key_id} " \
                "-authenticationKeyIssuerID #{issuer_id}"

    build_app(
      # 注意: `sh` は fastlane/ を cwd に走るが、**アクションはリポジトリルートを cwd に走る**。
      # そのため sh の引数は `../` 始まり、build_app の path はルート相対で書く。
      project: "GameCollection.xcodeproj",
      scheme: "GameCollection",
      # インストール済み fastlane が新表記 "app-store-connect" に未対応のため旧表記を使う
      # （どのバージョンでも通る。中身は同じ App Store Connect 向け配布）。
      export_method: "app-store",
      export_options: {
        teamID: TEAM_ID,
        signingStyle: "automatic",
        uploadSymbols: true,
      },
      xcargs: "-allowProvisioningUpdates #{auth_args} CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_xcargs: "-allowProvisioningUpdates #{auth_args}",
      buildlog_path: SHIP_LOG_DIR,
    )
    ensure
      FileUtils.rm_rf(auth_dir)
    end

    api_key = asc_api_key

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"],
    )
  end

  desc "API キーだけで Distribution 証明書を読み取る（取得のみ。作成も失効もしない）（#1041）"
  lane :signing_check do
    asc_api_key
    certs = Spaceship::ConnectAPI::Certificate.all.select do |c|
      %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type)
    end
    UI.message("Distribution 証明書: #{certs.size} / #{DISTRIBUTION_CERT_LIMIT} 枚")
    certs.each { |c| UI.message("  #{c.display_name} #{c.certificate_type} 期限 #{c.expiration_date}") }
    if certs.size >= DISTRIBUTION_CERT_LIMIT
      UI.important("上限に達しています。新規発行が失敗したら、不要な証明書を会長が失効させてください（自動では失効しません）")
    end
  end
end

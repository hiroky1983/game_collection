      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New tiles"
          }
        }
      }
    },
    "動かすたびに、空いたマスに新しいタイルが 1 枚出ます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each move adds one new tile to an empty square."
          }
        }
      }
    },
    "新しいタイルは 2 か 4 です。" : {
      "extractionState" : "manual",

            "state" : "translated",
            "value" : "The goal"
          }
        }
      }
    },
    "同じ数字のタイルを合体させて、大きな数字を作るゲームです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merge tiles with the same number to build bigger numbers."
          }
        }
      }
    },
    "2048 のタイルを作れたらクリアです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make a 2048 tile to clear the game."
          }
        }
      }
    },
    "1 回の番でやること" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you do on your turn"
          }
        }
      }
    },
    "上下左右のどれかへスワイプします。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up, down, left or right."
          }
        }
      }
    },
    "すべてのタイルが、その向きへ寄ります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every tile slides that way."
          }
        }
      }
    },
    "同じ数字で合体" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same numbers merge"
          }
        }
      }
    },
    "同じ数字どうしがぶつかると、合体して 2 倍になります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

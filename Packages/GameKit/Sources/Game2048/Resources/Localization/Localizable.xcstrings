        }
      }
    },
    "合体してできた数字が、スコアに入ります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The number you make by merging is added to your score."

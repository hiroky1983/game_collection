    "広告を最後まで視聴すると「戻す」を%lld回ぶん補充します。\n盤面はそのままです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Watch the ad to the end to get %lld more undo.\nYour board stays as it is."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Watch the ad to the end to get %lld more undos.\nYour board stays as it is."
                }
              }
            }
          }
        }
      }
    },
    "広告を見て%lld回補充する" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {

    },
    "ヒント、無料の回数は使い切りました。広告を見ると1回追加" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint. You've used your free hints. Watch an ad to add 1"
          }
        }
      }
    },
    "ヒントを使えませんでした" : {
      "extractionState" : "manual",
      "localizations" : {

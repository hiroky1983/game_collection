            "value" : "Game Over"
          }
        }
      }
    },
    "ゲームオーバー後に広告を見ると、1 回だけ小さい盆栽（%@）と線より上の盆栽を片づけて続けられます。スコアはそのままです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a game over, you can watch an ad once to clear the small bonsai (%@) and any bonsai above the line, then keep playing. Your score stays."
          }
        }
      }
    },
    "コンティニュー" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }

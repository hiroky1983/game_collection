{
  "sourceLanguage" : "ja",
  "strings" : {
    "%1$@。金の松どうしがくっつくと 2 つとも消えて %2$lld 点。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. When two Golden Pines merge, both vanish for %2$lld points."
          }
        }
      }
    },
    "%@の 5 種だけが出てきます。大きい盆栽はくっつけて育てます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only these 5 bonsai drop: %@. Grow bigger bonsai by merging."
          }
        }
      }
    },

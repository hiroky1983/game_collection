            "value" : "No card to continue with… You lose"
          }
        }
      }
    },
    "自分が取った札がノルマの枚数に届いた瞬間に勝ちです。かんたん=4枚・ふつう=6枚・むずかしい=9枚。届かないまま時間切れになると負けです" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You win the moment your cards reach the goal: Easy = 4, Normal = 6, Hard = 9. Run out of time first and you lose."
          }
        }
      }
    },
    "読みのルール" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading rules"
          }
        }
      }
    },
    "途中で終了すると、いまの対局が失われます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

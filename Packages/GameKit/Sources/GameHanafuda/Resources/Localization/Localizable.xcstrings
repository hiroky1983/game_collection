        }
      }
    },
    "決まった札をそろえると役ができます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collect certain cards to make a yaku."
          }
        }
      }
    },
    "役の一覧は、画面上の「役の早見表」で見られます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See every yaku in the \"Yaku list\" on the game screen."
          }
        }
      }
    },
    "あがるか、こいこいか" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop or Koi-Koi?"
          }
        }
      }
    },
    "役ができたら「あがり」で得点が決まります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you have a yaku, choose \"Stop\" to score it."
          }
        }
      }
    },
    "「こいこい」を選ぶと、続けて役を伸ばせます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose \"Koi-Koi\" to keep playing and build a bigger yaku."
          }
        }
      }
    },
    "こいこいのあとに相手があがると、相手の得点が 2 倍です。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your opponent stops after your Koi-Koi, their score is doubled."
          }
        }
      }
    },

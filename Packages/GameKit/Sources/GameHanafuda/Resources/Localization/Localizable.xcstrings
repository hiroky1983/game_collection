            "value" : "Stop"
          }
        }
      }
    },
    "あがるとその場で得点が確定し、局が終わります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopping locks in your points and ends the round."

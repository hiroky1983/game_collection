        }
      }
    },
    "札は 12 か月が 4 枚ずつ、全部で 48 枚。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 months, 4 cards each: 48 cards in all."
          }
        }
      }
    },
    "光・タネ・短冊・カスの 4 種類があります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are 4 kinds: Brights, Tane, Ribbons and Kasu."

    },
    "%lld枚目" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "card %lld"
          }
        }
      }
    },
    "1局につき1枚持っています。場札の列の上に置くと、その上にはどんな札でも1枚だけ重ねられます（空の列と、すでにジョーカーがある列には置けません）。上の札が全部はけると自動で消えて、下の札がまた使えるようになります" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have one per game. Place it on a tableau column and any one card can go on top of it (not on an empty column or one that already has a Joker). Once the cards on top of it are all cleared, it disappears and the card underneath can be used again"
          }
        }
      }
    },
    "1手戻す、残り%lld回" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo, %lld left"
          }
        }
      }
    },
    "1手戻す、残りなし" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo, none left"
          }
        }

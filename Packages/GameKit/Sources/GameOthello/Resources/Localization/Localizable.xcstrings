    },
    "1 回の番でやること" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What to do on your turn"
          }
        }
      }
    },
    "半透明の○が、いま置けるマスです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The faint circles show where you can place a stone."
          }
        }
      }
    },
    "○のマスをタップして、自分の石を置きます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a circle to place your stone."
          }
        }
      }
    },
    "はさむと裏返る" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandwich to flip"
          }
        }
      }
    },
    "自分の石で相手の石をはさめるマスにだけ置けます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can only place where your stones sandwich your opponent's."
          }
        }
      }
    },
    "はさんだ相手の石は、すべて自分の色に裏返ります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sandwiched stone flips to your color."
          }
        }
      }
    },
    "置けないとき" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you can't place"
          }
        }
      }
    },
    "置けるマスが無いときは、自動でパスになります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If there is nowhere to place, you pass automatically."
          }
        }
      }
    },
    "パスをすると、相手の番になります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a pass, it is your opponent's turn."
          }
        }
      }
    },
    "勝ち負けの決まり" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to win or lose"
          }
        }
      }
    },
    "盤が埋まるか、どちらも置けなくなると終わりです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ends when the board is full or neither side can place."
          }
        }
      }
    },
    "石が多い方の勝ち。同じ数なら引き分けです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More stones wins. The same number is a draw."
          }
        }
      }
    },
    "空きマスを残して終わったら、空きマスは勝った方の得点になります。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If empty squares remain at the end, they count for the winner."
          }
        }
      }
    },

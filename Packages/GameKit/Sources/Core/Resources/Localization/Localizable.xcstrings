          }
        }
      }
    },
    "手数が少ないほど良い記録です。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fewer moves is a better record."

      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to jump. Hold longer to jump higher over holes and obstacles. Tap again in the air for a double jump. He can only pedal on the ground, so keeping jumps low builds more speed."

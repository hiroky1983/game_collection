{
  "sourceLanguage" : "ja",
  "strings" : {
    "ラスト" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final"
          }
        }
      }
    },
    "出せない札を払うと手札に戻ります（ペナルティはありません）。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A card that can't be played slides back to your hand (no penalty)."
          }
        }
      }
    },
    "手札の札を、出したい台札のほうへ払うと出せます。台札の上まで動かして離しても出せます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flick a card from your hand toward the pile you want to play it on. You can also drag it onto the pile and let go."
          }
        }
      }
    },
    "最後の勝負" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final round"
          }
        }
      }
    },
    "最後の勝負、%@" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Final round, %@"
          }
        }
      }
    },

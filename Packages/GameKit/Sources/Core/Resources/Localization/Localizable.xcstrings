          }
        }
      }
    },
    "場より強い組を出そう" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play a set stronger than the table"
          }
        }
      }
    },
    "場札は 1 つ小さくて色ちがいの札だけ重ねられます。" : {

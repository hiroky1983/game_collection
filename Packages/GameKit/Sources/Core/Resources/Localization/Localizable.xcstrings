    "遊び方" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to Play"
          }
        }
      }
    },
    "選ばなかったカードは 1 回だけ引き直せます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can redraw the cards you didn't pick, once."
          }
        }
      }
    },
    "配当は数字 1 点で 35 倍、12 個の区分で 2 倍、赤黒などは 1 倍（元金も戻ります）。0 は緑で、赤黒などの賭けはすべて外れです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single number pays 35 to 1, a group of 12 pays 2 to 1, and red/black and the like pay 1 to 1 (your bet comes back too). 0 is green, and all red/black-type bets lose on it."
          }
        }
      }
    },
    "長押しで旗を立てられる" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold to plant a flag"
          }
        }
      }
    },
    "閉じる" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap next to the gap to slide"
          }
        }
      }
    },
    "立直できるのは鳴いていない手だけで、1000 点を供託します。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

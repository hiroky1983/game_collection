            "state" : "translated",
            "value" : "%lld left"
          }
        }
      }
    },
    "あなたの勝ち！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You Win!"
          }
        }
      }
    },
    "あなたの番" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your turn"
          }
        }
      }
    },
    "あなたの直前の1手を、CPU の応手ごと取り消します" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes back your last move along with the CPU's reply"
          }
        }
      }
    },
    "あなたの直前の1手を、CPU の応手ごと取り消します。\n無料で使えるのは1回だけです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takes back your last move along with the CPU's reply.\nYou get one free undo."
          }
        }
      }
    },
    "あなたの負け" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {

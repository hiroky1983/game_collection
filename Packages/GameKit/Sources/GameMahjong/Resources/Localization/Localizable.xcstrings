    "CPU 3 人と対局します。東 1 局から東 4 局まで打ちます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You play against 3 CPUs, from East 1 through East 4."
          }
        }
      }
    },
    "CPU 3 人と対局します。東 1 局だけを打ちます。" : {
      "extractionState" : "manual",

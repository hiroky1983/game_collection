      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riichi, Menzen Tsumo, Pinfu, Iipeikou and Chiitoitsu are lost, and Sanshoku, Ittsu, Chanta, Honitsu and others drop 1 Han. Aim for yaku that still count when open, like Yakuhai. Only a closed Kan keeps your hand closed"
          }

    "1枚ツモって1枚切る。4面子+雀頭で和了" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draw a tile, discard a tile. Win with 4 sets + a pair"
          }
        }
      }
    },
    "1種類の数牌だけで作る（字牌も使わない）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only tiles of one suit (no honor tiles)"
          }
        }
      }
    },
    "1種類の数牌と字牌だけで作る" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only tiles of one suit plus honor tiles"

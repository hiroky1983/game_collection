    "ロン" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ron"
          }
        }
      }
    },
    "ロンは、子なら基本点×4、親なら基本点×6。ツモは、子の和了なら親が基本点×2・子が基本点×1ずつ、親の和了なら全員が基本点×2ずつ払います。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ron: base × 4 for a non-dealer, base × 6 for the dealer. Tsumo: when a non-dealer wins, the dealer pays base × 2 and each other player pays base × 1; when the dealer wins, everyone pays base × 2."
          }
        }
      }
    },
    "・" : {
      "extractionState" : "manual",

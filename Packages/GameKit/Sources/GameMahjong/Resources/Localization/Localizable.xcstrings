          }
        }
      }
    },
    "他の人の捨て牌はポン・チー・カンで鳴けます（鳴くと立直はできません）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Call others' discards with Pon, Chii or Kan (an open hand can't declare Riichi)"
          }
        }
      }
    },
    "他家が加槓した牌でロンする" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@, from the top, smallest first: %2$@ (%3$lld disk)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@, from the top, smallest first: %2$@ (%3$lld disks)"

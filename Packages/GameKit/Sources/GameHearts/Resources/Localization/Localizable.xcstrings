      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play against 3 CPUs. All 52 cards are dealt, 13 each. Everyone plays one card in turn, and the highest card takes all 4. The winner leads the next trick"

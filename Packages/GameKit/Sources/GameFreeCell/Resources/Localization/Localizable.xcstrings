    "フリーセルが全部埋まり、どの札も置き先がありません。この配札は必ずクリアできるので、手を戻せばやり直せます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All free cells are full and no card has anywhere to go. This deal can always be cleared, so undo some moves and try again."
          }
        }
      }
    },
    "フリーセル（1 枚ずつ置いておける）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

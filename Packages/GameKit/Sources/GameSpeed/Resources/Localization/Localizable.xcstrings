        }
      }
    },
    "どちらも出せない！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No moves!"
          }
        }
      }
    },
    "どちらも出せません。めくってください" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No one can play. Flip new cards"
          }
        }
      }
    },
    "どちらも出せる札が無くなったら「めくる」。両方の山札から1枚ずつ台札に置きます。山札が無いときは、自分側の台札を切り直して山札にします" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When neither side can play, tap Flip. One card from each stock goes onto the piles. If your stock is empty, your side's pile is shuffled into a new stock."
          }
        }
      }
    },

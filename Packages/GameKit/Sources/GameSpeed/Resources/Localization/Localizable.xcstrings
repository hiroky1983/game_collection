      }
    },
    "手札と山札を先に出し切ったほうの勝ち。めくるだけが続いて場が動かないときは引き分けです" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first to play out their hand and stock wins. If nothing but flips keeps happening, the game is a draw."
          }
        }
      }
    },
    "最速" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best"
          }
        }
      }
    },
    "札を出すと、自分の山札から手札に1枚補充されます（手札はいつも4枚まで）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each time you play a card, one card from your stock refills your hand (you hold up to 4 cards)."

        }
      }
    },
    "配られた手札は %lld 枚です。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are dealt %lld cards."
          }
        }
      }
    },
    "山札があるあいだは、1 枚出すごとに 1 枚補充されます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While your stock lasts, each card you play is refilled from it."
          }
        }
      }
    },
    "どちらも出せないとき" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When neither side can play"

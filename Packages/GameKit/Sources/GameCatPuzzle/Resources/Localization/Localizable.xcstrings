    "ヒント" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint"
          }
        }
      }
    },
    "ヒント: %1$@の猫は%2$@にしかいないので、%2$@のほかのマスに猫はいない" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: the %1$@ cat can only be in %2$@, so no other cell in %2$@ has a cat"
          }
        }
      }
    },
    "ヒント: %@で猫が入れるのはここだけ。猫はここ！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: this is the only cell left in %@. The cat is here!"
          }
        }
      }
    },
    "ヒント: %@の猫と同じ行・列・部屋と、その隣のマスに、ほかの猫はいない" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: no other cat shares the %@ cat's row, column or room, or sits next to it"
          }
        }
      }
    },
    "ヒント: %@の猫は答えと合わないので外すよ" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: the %@ cat doesn't fit the answer, so it comes off"
          }
        }
      }
    },
    "ヒント: ここに猫がいると%@に猫が入れなくなるので、ここに猫はいない" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: a cat here would leave no room for the cat in %@, so there is no cat here"
          }
        }
      }
    },
    "ヒント: ここに猫がいると、決まるマスを埋めていくと%@に猫が入れなくなるので、ここに猫はいない" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: a cat here, once the forced cells are filled in, would leave no room for the cat in %@, so there is no cat here"
          }
        }
      }
    },
    "ヒント: ここは決まり。%@の猫はここ！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: this one is certain. The %@ cat is here!"
          }
        }
      }
    },
    "ヒント: 同じ列に2匹はいないので、%@の猫を外すよ" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: no column has two cats, so the %@ cat comes off"
          }
        }
      }
    },
    "ヒント: 同じ行に2匹はいないので、%@の猫を外すよ" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: no row has two cats, so the %@ cat comes off"
          }
        }
      }
    },
    "ヒント: 同じ部屋に2匹はいないので、%@の猫を1匹外すよ" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: no room has two cats, so one cat in the %@ comes off"
          }
        }
      }
    },
    "ヒント: 猫どうしは隣り合わないので、%@の猫を外すよ" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hint: cats never sit next to each other, so the %@ cat comes off"
          }
        }
      }
    },
    "ヒント、無料の回数は使い切りました。広告を見ると1回追加" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {

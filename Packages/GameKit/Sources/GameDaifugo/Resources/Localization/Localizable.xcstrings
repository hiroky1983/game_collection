    },
    "反則上がり" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foul Finish"
          }
        }
      }
    },
    "同じ数字を4枚以上まとめて出すと革命。カードの強さが上下逆になります（もう一度出すと元に戻ります）" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playing 4 or more cards of the same number at once starts a Revolution: card strength is reversed (another Revolution flips it back)."
          }
        }
      }
    },
    "場" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table"
          }
        }
      }
    },
    "場が空なら好きな組（1枚・ペア・3枚…）を出せます。場に組があるときは同じ枚数で、より強い組だけ出せます" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the table is clear, you can lead any set (a single card, a pair, three of a kind…). Otherwise, you must play the same number of cards, and they must be stronger."
          }
        }
      }
    },
    "場の %@ より強い数字が必要です" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need a number stronger than the %@ on the table"

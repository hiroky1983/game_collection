      }
    },
    "最後の1手が 2・8・ジョーカーだと反則。上がっても大貧民に落ちます" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Going out with a 2, an 8, or a Joker as your final play is a foul. You drop to Beggar even though you went out."

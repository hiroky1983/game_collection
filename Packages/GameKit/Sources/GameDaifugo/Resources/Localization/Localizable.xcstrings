    "CPU3人と対戦。革命・8切りあり！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take on 3 CPUs. With Revolutions and 8-Stops!"
          }
        }
      }
    },
    "CPU3人と対戦します。手札を早く出し切るほど上の階級になり、決着すると階級に応じてカードを交換して次のゲームへ進みます" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You play against 3 CPUs. The sooner you get rid of all your cards, the higher your rank. When a game ends, players exchange cards based on their rank and the next game begins."
          }
        }
      }
    },

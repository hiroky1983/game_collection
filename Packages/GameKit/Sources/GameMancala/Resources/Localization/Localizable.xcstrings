    },
    "終了して新規対局" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "End and start new game"
          }
        }
      }
    },
    "終局" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game over"
          }
        }
      }
    },
    "自分の穴を 1 つ選ぶと、中の種をすべて取り、反時計回りに 1 個ずつ次の穴へ入れていきます。自分のストアには入れますが、相手のストアは飛ばします。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick one of your pits, take all its seeds, and drop them one at a time into the following pits, counterclockwise. You drop seeds into your own store but skip the opponent's."
          }
        }
      }
    },
    "途中で終了すると対局データが失われます。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you quit now, this game will be lost."
          }
        }
      }

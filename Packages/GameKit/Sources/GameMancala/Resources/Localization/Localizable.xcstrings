      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ends when all pits on either side are empty. Seeds left in the pits go to that side's store, and whoever has more seeds in their store wins. Equal counts are a draw."

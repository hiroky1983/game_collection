        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahjong Solitaire: first steps"
          }
        }
      }
    },
    "このゲームの目的" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The goal"
          }
        }
      }
    },
    "積まれた牌を、すべて消したらクリアです。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear all the stacked tiles to win."
          }
        }

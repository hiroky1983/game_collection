    "亀甲" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turtle"
          }
        }
      }
    },
    "全部で144枚（標準の34種が4枚ずつ + 花牌4枚 + 季節牌4枚）です。配る盤面は取り切れる順番があるように作っているので、必ずクリアできます" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are 144 tiles in all (4 each of the 34 standard tiles, plus 4 flowers and 4 seasons). Every board is dealt so there's an order that clears it, so you can always win"
          }
        }
      }
    },
    "全部取り切った！" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Board Cleared!"
          }
        }
      }
    },
    "全部消したらクリア" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear them all to win"
          }
        }
      }
    },
    "十字" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {

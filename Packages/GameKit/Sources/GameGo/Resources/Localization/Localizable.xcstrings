    "CPUはパスしました" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CPU passed"
          }
        }
      }
    },
    "CPUは%1$lld行%2$lld列に打ちました" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",

            "state" : "translated",
            "value" : "Clear play records?"
          }
        }
      }
    },
    "ベストスコア・最短タイム・勝敗と連勝の記録、遊んだ回数・勝った回数、おすすめや評価のお願い・遊び方ガイドの表示履歴を消します。元に戻せません。" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This erases best scores, fastest times, wins, losses and streaks, play and win counts, and the history of suggestions, rating requests, and how-to-play guides shown. This can't be undone."
          }
        }
      }
    },
